# Copiá este archivo como .env y completá con los datos de tu proyecto Supabase
# (Dashboard → Project Settings → API). Sin estas variables la app corre en "modo demo".
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=tu-publishable-o-anon-key

# Opcional: estilo de mapa MapLibre (por defecto OpenFreeMap Positron, gratis y sin key)
# EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# URL de las funciones de Vercel (api/login, api/menu-preview). En web se omite (misma app);
# en la app nativa es obligatoria. Los builds de EAS la toman de eas.json.
# EXPO_PUBLIC_API_URL=https://food-track-web.vercel.app

# Opcional: verificación anti-bots (Cloudflare Turnstile) al ingresar y crear cuenta. Es la clave PÚBLICA del
# sitio; la secreta se carga en Supabase (Authentication → Attack Protection → CAPTCHA). Sin esta variable
# la app no pide verificación. En la app nativa necesita además EXPO_PUBLIC_API_URL (carga /captcha.html).
# EXPO_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
